# Postgres (used by docker-compose)
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/meridian
DATABASE_USERNAME=meridian
DATABASE_PASSWORD=meridian
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1   # Ollama OpenAI-compatible endpoint, when the backend runs on the host
AI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1   # same endpoint, as seen from the backend container
AI_API_KEY=ollama                       # any string for Ollama; real key for hosted providers
AI_MODEL=qwen3:4b-instruct-2507
AI_MAX_CONCURRENCY=1
AI_TIMEOUT_SECONDS=90
PLACES_PROVIDER=osm
OVERPASS_URL=https://overpass-api.de/api/interpreter   # comma-separated list = mirrors tried in order
NOMINATIM_URL=https://nominatim.openstreetmap.org
APP_BASE_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
